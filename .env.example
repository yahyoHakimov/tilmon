# Prod serverda /opt/tilmon/.env sifatida yotadi (git'ga tushmaydi).
# docker-compose.yml shu qiymatlarni o'qiydi.

# --- Postgres ---
POSTGRES_USER=tilmon
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tilmon

# --- Backend ---
# Kuchli tasodifiy qiymat: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
SESSION_DAYS=14

# Sayt https bo'lgani uchun cookie faqat shifrlangan ulanishda yuborilsin.
SECURE_COOKIES=1

# CORS: frontend qaysi manzillardan keladi.
ALLOWED_ORIGINS=https://tilmon.uz,https://www.tilmon.uz

# --- OpenAI ---
# Kalitsiz tizim yiqilmaydi, lekin erkin matn tahlil qilinmaydi.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bir foydalanuvchi uchun soatiga nechta tasnif so'rovi.
RATE_LIMIT_HOURLY=120
