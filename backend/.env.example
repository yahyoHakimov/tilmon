# Nusxa oling:  cp .env.example .env
# .env fayli .gitignore da — hech qachon commit qilinmaydi.

# ── Ma'lumotlar bazasi ──────────────────────────────────────────────────
# Lokal ishlab chiqish uchun Docker konteyneri:
#   docker run -d --name tilmon-pg-dev \
#     -e POSTGRES_USER=tilmon -e POSTGRES_PASSWORD=tilmon_dev \
#     -e POSTGRES_DB=tilmon -p 55432:5432 postgres:18-alpine
DATABASE_URL=postgresql+psycopg://tilmon:tilmon_dev@127.0.0.1:55432/tilmon

# ── Sessiyalar ──────────────────────────────────────────────────────────
# Yaratish:  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=14

# Ishlab chiqarishda 1 (cookie faqat HTTPS orqali).
# Lokal HTTP uchun 0 qiling, aks holda brauzer cookie'ni saqlamaydi.
SECURE_COOKIES=0

# Frontend manzillari, vergul bilan.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── OpenAI ──────────────────────────────────────────────────────────────
# Ekstraktor vazifasi tor (matn -> yopiq qiymatlar), arzon model yetarli.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ro'yxatdan o'tish taklif kodisiz mumkinmi.
# Sukut bo'yicha yopiq. Demo/sinov davri uchun 1 qiling — istalgan payt
# qaytarib yopish mumkin, kod o'zgarmaydi.
REGISTRATION_OPEN=0

# Bir foydalanuvchi uchun soatiga nechta tasnif so'rovi.
RATE_LIMIT_HOURLY=120
